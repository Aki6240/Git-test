# ============================================
#  Git-test 通用忽略规则
# ============================================

# ---------- 操作系统 ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
*.lnk

# ---------- 编辑器 / IDE ----------
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
.project
.classpath
.settings/

# ---------- Node.js ----------
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
dist/
build/
.next/
.nuxt/
coverage/
*.tsbuildinfo

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
.Python
env/
venv/
.venv/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# ---------- 环境变量与密钥（重要：别提交上去） ----------
.env
.env.local
.env.*.local
*.pem
*.key
secrets.json
.token

# ---------- 日志与临时文件 ----------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
